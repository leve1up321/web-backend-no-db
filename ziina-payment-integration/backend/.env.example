# Ziina API Configuration
ZIINA_SECRET_KEY=your_ziina_secret_key_here
ZIINA_WEBHOOK_SECRET=your_webhook_secret_here
ZIINA_API_URL=https://api.ziina.com/v1

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Security
JWT_SECRET=your_jwt_secret_here

# Database (Optional - for storing payment records)
# DATABASE_URL=postgresql://username:password@localhost:5432/ziina_payments

# Logging
LOG_LEVEL=info
