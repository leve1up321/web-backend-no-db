# Ziina Payment Gateway Configuration
# احصل على هذه المفاتيح من لوحة تحكم Ziina Business
ZIINA_SECRET_KEY=your_ziina_secret_key_here
ZIINA_WEBHOOK_SECRET=your_webhook_secret_here

# Base URL للموقع (مهم لروابط إعادة التوجيه)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Resend Email Service (للبريد الإلكتروني)
RESEND_API_KEY=your_resend_api_key_here

# Vercel Blob Storage (لرفع الملفات الرقمية)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# إعدادات قاعدة البيانات (اختياري - للمرحلة المتقدمة)
# DATABASE_URL=your_database_connection_string_here

# إعدادات البريد الإلكتروني
ADMIN_EMAIL=admin@levelup-store.com
SUPPORT_EMAIL=support@levelup-store.com

# إعدادات الأمان
JWT_SECRET=your_jwt_secret_for_download_links

# بيئة التطوير (production أو development)
NODE_ENV=development

# إعدادات إضافية (اختيارية)
# SLACK_WEBHOOK_URL=your_slack_webhook_url
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
