# Ziina Payment Gateway Configuration
# احصل على هذا المفتاح من لوحة تحكم Ziina Business
ZIINA_SECRET_KEY=your_ziina_secret_key_here

# Base URL للموقع (اختياري - سيتم تحديده تلقائياً من Vercel)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# بيئة التطوير (production أو development)
NODE_ENV=development

# إعدادات إضافية (اختيارية)
# EMAIL_SERVICE_API_KEY=your_email_service_key
# SLACK_WEBHOOK_URL=your_slack_webhook_url
# DATABASE_URL=your_database_connection_string
