# 🔑 Ziina Payment Gateway Configuration (REQUIRED)
# احصل على هذه المفاتيح من لوحة تحكم Ziina Business
# https://business.ziina.com/
ZIINA_SECRET_KEY=sk_test_your_ziina_secret_key_here
ZIINA_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# 🌐 Base URLs للموقع (REQUIRED)
# مهم جداً لروابط إعادة التوجيه وعمل الـ webhooks
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
VERCEL_URL=your-domain.vercel.app

# 📧 Resend Email Service (REQUIRED)
# للبريد الإلكتروني وتأكيد الطلبات
# https://resend.com/
RESEND_API_KEY=re_your_resend_api_key_here

# 📁 Vercel Blob Storage (REQUIRED for digital products)
# لرفع وتخزين الملفات الرقمية
BLOB_READ_WRITE_TOKEN=vercel_blob_your_token_here

# 👨‍💼 إعدادات الإدارة والدعم (REQUIRED)
ADMIN_EMAIL=admin@levelup-store.com
SUPPORT_EMAIL=support@levelup-store.com
STORE_NAME="متجر لفل اب"
STORE_LOGO_URL=https://your-domain.com/logo.png

# 🔒 إعدادات الأمان (REQUIRED)
JWT_SECRET=your_super_secure_jwt_secret_for_download_links_min_32_chars

# 🗄️ قاعدة البيانات (OPTIONAL - يدعم No-DB mode)
# إذا لم تحدد DATABASE_URL، سيستخدم النظام ملفات JSON في مجلد data/
# MongoDB Atlas (recommended) - احصل على رابط مجاني من https://mongodb.com/atlas
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/levelup_store?retryWrites=true&w=majority

# أو قاعدة بيانات محلية (للتطوير فقط)
# DATABASE_URL=mongodb://localhost:27017/levelup_store

# قواعد بيانات أخرى (OPTIONAL - للمرحلة المتقدمة)
# DATABASE_URL=postgresql://user:password@localhost:5432/levelup_store
# DATABASE_URL=file:./dev.db

# 🚫 No-DB Mode (AUTOMATIC FALLBACK)
# إذا لم تحدد DATABASE_URL، سيستخدم النظام:
# - data/orders.json للطلبات
# - data/users.json للمستخدمين
# - ذاكرة مؤقتة للجلسات

# 🛠️ بيئة التطوير
NODE_ENV=development

# 📊 تحليلات وإحصائيات (OPTIONAL)
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
FACEBOOK_PIXEL_ID=your_facebook_pixel_id

# 💬 إشعارات الدعم (OPTIONAL)
# لإرسال إشعارات للإدارة عند الطلبات الجديدة
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# 🎨 إعدادات المظهر (OPTIONAL)
NEXT_PUBLIC_THEME_COLOR=#1a365d
NEXT_PUBLIC_BRAND_COLOR=#3182ce

# 🔧 إعدادات متقدمة (OPTIONAL)
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
MAX_FILE_SIZE_MB=50
