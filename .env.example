# Ziina Payment Gateway Configuration
# احصل على هذه المفاتيح من لوحة تحكم Ziina Business
ZIINA_SECRET_KEY=your_ziina_secret_key_here
ZIINA_WEBHOOK_SECRET=your_ziina_webhook_secret_here

# Base URL للموقع (مهم لروابط إعادة التوجيه)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend Email Service (للبريد الإلكتروني)
RESEND_API_KEY=your_resend_api_key_here

# Vercel Blob Storage (لرفع الملفات الرقمية)
BLOB_READ_WRITE_TOKEN=your_blob_token_here

# إعدادات قاعدة البيانات (اختياري - للمرحلة المتقدمة)
# DATABASE_URL=postgresql://username:password@host:port/database

# إعدادات البريد الإلكتروني
ADMIN_EMAIL=your_admin_email@example.com
SUPPORT_EMAIL=your_support_email@example.com

# إعدادات الأمان
JWT_SECRET=your_jwt_secret_key_here

# بيئة التطوير (production أو development)
NODE_ENV=development

# إعدادات إضافية (اختيارية)
# SLACK_WEBHOOK_URL=your_slack_webhook_url
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token

